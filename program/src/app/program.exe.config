<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Program stoi często na dysku sieciowym (np. \\192.168.x.x = strefa Internet) albo jest rozpakowany z zipa
       pobranego z internetu. Bez tego .NET Framework odmawia wczytania Python.Runtime.dll (okno programu). -->
  <runtime>
    <loadFromRemoteSources enabled="true"/>
  </runtime>
</configuration>
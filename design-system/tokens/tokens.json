    "rules": {
      "text": "text i text-muted >= 4.5:1 na każdym poziomie L0-L4",
      "label": "etykieta beżowa (label) tylko na L0-L1, >= 3.0:1 (bold >= 14 px); na L2+ etykieta w text-muted",
      "brand": "link / zielony tekst (brand) na L0-L3 >= 4.5:1; na L4 (nakładka) link w kolorze brand-hover",
      "step": "skok sąsiadów 0.015-0.045 L (OKLCH), jeden kierunek; L4-L0 >= 0.06",
      "white": "L0 = czysta biel (biała kartka programu) we wszystkich jasnych stylach od 1.5.0; w ciemnych brak bieli"
    }
